server {
    listen 80;
    listen [::]:80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    # En-têtes de sécurité : inclus dans chaque location (nginx n'hérite pas des add_header du parent)

    # Fichiers versionnés par Vite (hash dans le nom) : cache long
    location /assets/ {
        expires 1y;
        include /etc/nginx/conf.d/securite.inc;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA : toute route inconnue renvoie index.html (React Router gère le 404)
    location / {
        include /etc/nginx/conf.d/securite.inc;
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
