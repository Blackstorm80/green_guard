# Variables lues par docker-compose.yml — copier en `.env` à la racine (jamais commité).

# Mot de passe PostgreSQL (obligatoire hors poste de dev)
POSTGRES_PASSWORD=a_changer

# Clé secrète JWT — générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=a_generer

# URL du frontend autorisée par CORS
FRONTEND_URL=http://localhost:3000
