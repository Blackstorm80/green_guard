# Variables lues par docker-compose.yml — copier en `.env` à la racine (jamais commité).

# Mot de passe PostgreSQL (obligatoire hors poste de dev)
POSTGRES_PASSWORD=a_changer

# Clé secrète JWT (32 caractères minimum)
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=a_generer

# URL du frontend autorisée par CORS
FRONTEND_URL=http://localhost:3000

# URL de l'API vue par le navigateur : lue au BUILD du front, et origine autorisée par sa CSP
VITE_API_URL=http://localhost:8000/api/v1
API_ORIGIN=http://localhost:8000

# Derrière HTTPS en production : HSTS=true (COOKIE_SECURE reste true)
COOKIE_SECURE=true
HSTS=false
