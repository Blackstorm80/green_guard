# Variables lues par docker-compose.yml — copier en `.env` à la racine (jamais commité).

# Mot de passe PostgreSQL (obligatoire hors poste de dev)
POSTGRES_PASSWORD=a_changer

# Clé secrète JWT (32 caractères minimum)
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=a_generer

# URL du frontend autorisée par CORS
FRONTEND_URL=http://localhost:3000

# URL de l'API vue par le navigateur : lue au BUILD du front, et origine autorisée par sa CSP
VITE_API_URL=http://localhost:8000/api/v1
API_ORIGIN=http://localhost:8000

# Derrière HTTPS en production : HSTS=true (COOKIE_SECURE reste true)
COOKIE_SECURE=true
HSTS=false

# Interfaces sur lesquelles l'API (8000) et le front (3000) sont publiés. 127.0.0.1 par défaut :
# en production, le reverse proxy TLS de l'hôte est le seul point d'entrée (0.0.0.0 les ouvrirait au réseau)
API_BIND=127.0.0.1
FRONT_BIND=127.0.0.1

# Proxys dont l'en-tête X-Forwarded-For est cru (adresses ou réseaux CIDR, séparés par des virgules).
# Adresse du reverse proxy TELLE QUE VUE PAR LE CONTENEUR : derrière un proxy sur l'hôte et un port
# publié, c'est la passerelle du réseau Docker (ex. 172.18.0.1, ou 172.16.0.0/12). Voir exploitation.md
TRUSTED_PROXIES=127.0.0.1

# Limitation de débit de la connexion, par fenêtre de 60 s : par identifiant (strict) et par IP (large)
AUTH_RATE_LIMIT=10
AUTH_RATE_LIMIT_IP=100

# Documentation interactive /docs, /redoc, /openapi.json : false en production
ENABLE_DOCS=false

# Fuseau du jour métier (bilan hydrique, cumuls météo journaliers)
FUSEAU_HORAIRE=Europe/Paris
