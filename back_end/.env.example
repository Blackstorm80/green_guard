# Copier ce fichier en `.env` (jamais commité) puis renseigner les valeurs.

# Base de données PostgreSQL — format : postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://greenguard:greenguard_dev@localhost:5432/greenguard

# Clé secrète JWT — générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=a_generer

# URL du frontend autorisée par CORS
FRONTEND_URL=http://localhost:5173
