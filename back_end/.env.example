# Copier ce fichier en `.env` (jamais commité) puis renseigner les valeurs.

# Base de données PostgreSQL — format : postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://greenguard:greenguard_dev@localhost:5432/greenguard

# Clé secrète JWT (32 caractères minimum, sinon l'API refuse de démarrer)
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=a_generer

# URL du frontend autorisée par CORS
FRONTEND_URL=http://localhost:5173

# Cookie de session Secure (true ; http://localhost est accepté par les navigateurs)
COOKIE_SECURE=true

# Développement sans worker : exécuter le job planifié dans l'API (une seule instance !)
ENABLE_SCHEDULER=true

# Journalisation : text (développement) ou json (production)
LOG_FORMAT=text

# Documentation interactive (/docs, /redoc, /openapi.json) : utile en développement, false en production
ENABLE_DOCS=true

# Fuseau du jour métier (bilan hydrique, cumuls météo journaliers)
FUSEAU_HORAIRE=Europe/Paris
